# RailPulse API proxy configuration.
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file or put these keys in the Flutter app.

PORT=8787

# Railway data provider: "irctc" (irctc.dev) or "railkit" (railkit.in).
# If omitted, the proxy uses RailKit when RAILKIT_API_KEY is set, else irctc.dev.
RAILWAY_PROVIDER=irctc

# irctc.dev API key. Keep server-side only.
IRCTC_API_KEY=

# RailKit API key from https://railkit.in (only used with RAILWAY_PROVIDER=railkit).
RAILKIT_API_KEY=

# Optional base URL override for irctc.dev.
IRCTC_BASE_URL=https://api.irctc.dev

# Force demo mode even when a key is present (useful for UI work / screenshots).
# Demo responses are always labelled source:"demo" and contain sample data only.
RAILPULSE_DEMO=0

# Comma separated list of allowed browser origins. Native apps do not need CORS.
CORS_ORIGIN=*
